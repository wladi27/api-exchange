# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3003
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3003

# ==========================================
# BASE DE DATOS MONGODB
# ==========================================
# Para MongoDB Atlas en la nube:
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/dolar_api?retryWrites=true&w=majority

# ==========================================
# SEGURIDAD Y TOKENS JWT
# ==========================================
JWT_SECRET=tu_clave_secreta_super_segura_jwt_2026_genera_una_aleatoria

# ==========================================
# CUENTA INICIAL DE ADMINISTRADOR (SEED)
# ==========================================
INITIAL_ADMIN_EMAIL=admin@dolarapi.com
INITIAL_ADMIN_PASSWORD=Admin123456!
INITIAL_ADMIN_NAME=Super Administrador

# ==========================================
# DATOS DE PAGO MÓVIL (BOLÍVARES)
# ==========================================
PAGO_MOVIL_BANK=0102 - Banco de Venezuela
PAGO_MOVIL_PHONE=0412-1234567
PAGO_MOVIL_ID=V-12345678

# ==========================================
# DATOS DE BINANCE PAY Y USDT (CRYPTO)
# ==========================================
BINANCE_PAY_ID=123456789
BINANCE_PAY_EMAIL=pagos@dolarapi.com
USDT_TRC20_ADDRESS=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USDT_BEP20_ADDRESS=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# SERVICIO DE CORREO GRATUITO (RECUPERACIÓN)
# ==========================================
# Resend (3,000 correos gratis/mes sin tarjeta en https://resend.com):
RESEND_API_KEY=re_123456789_tu_clave_aqui
EMAIL_FROM=Klipp <seguridad@klipp.lat>
